# iFinD MCP 认证信息。不要把真实密钥提交到 Git。
IFIND_API_KEY=
IFIND_MCP_BASE_URL=http://219.141.246.230:5223/sse

# Legacy HTTP transport remains compatible and emits a warning. Enable strict
# transport after an HTTPS, trusted VPN or tunnel endpoint is verified.
IFIND_ALLOW_INSECURE_HTTP=0
IFIND_REQUIRE_SECURE_TRANSPORT=0

# 设为 1 后，iFinD 未连接或兼容性校验失败时禁止生成每日快照。
IFIND_REQUIRED=0

# 网页“更新今日数据”按钮。线上由 Sites 配置，本地令牌只存用户环境变量。
REFRESH_OWNER_EMAIL=
REFRESH_WORKER_TOKEN=
