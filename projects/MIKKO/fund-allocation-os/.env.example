# iFinD MCP credentials. Never commit the real key.
IFIND_API_KEY=
IFIND_MCP_BASE_URL=http://219.141.246.230:5223/sse

# Refuse data-dependent workflows when iFinD fails its contract check.
IFIND_REQUIRED=1

# Optional. Leave blank when `node` is on PATH. Codex Desktop fallback is auto-detected.
NODE_EXECUTABLE=

# API authentication. Use a long random value outside local development.
AUTH_SIGNING_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=3600
AUTH_RATE_LIMIT_PER_MINUTE=60
