{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Factory Slide Plan",
  "type": "object",
  "properties": {
    "slideIndex": { "type": "integer", "minimum": 1 },
    "role": { "type": "string" },
    "message": { "type": "string" },
    "importance": { "enum": ["low", "medium", "high", "critical"] },
    "density": { "enum": ["low", "medium_low", "medium", "medium_high", "high"] },
    "layoutSource": { "enum": ["golden_slide", "system_layout", "reference_layout", "generative_layout"] },
    "visualPriority": { "enum": ["text", "chart", "image", "balanced", "diagram"] },
    "chartPackRef": { "type": "string", "minLength": 1 },
    "components": { "type": "array", "items": { "type": "string" } },
    "renderRoutes": { "type": "object", "additionalProperties": { "enum": ["native", "svg", "image", "html_preview"] } },
    "editableLevel": { "enum": ["native", "hybrid", "image-heavy"] },
    "goldenMatch": {
      "type": "object",
      "properties": {
        "status": { "enum": ["selected", "fallback"] },
        "layoutSource": { "enum": ["golden_slide", "generative_layout"] },
        "candidateId": { "type": "string" },
        "sourceSlide": { "type": "integer", "minimum": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["status", "layoutSource", "score", "threshold", "evidence"]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value", "numericValue", "unit", "sourceText"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "numericValue": { "type": "number" },
          "unit": { "type": "string" },
          "sourceText": { "type": "string" }
        }
      }
    },
    "bindingTargets": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "objectName", "template"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "text" },
              "objectName": { "type": "string", "minLength": 1 },
              "template": { "type": "string", "pattern": "\\{\\{[^{}]+\\}\\}" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "objectName", "categoriesTemplate", "series"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "chart" },
              "objectName": { "type": "string", "minLength": 1 },
              "categoriesTemplate": { "type": "string", "pattern": "^\\{\\{[^{}]+\\}\\}$" },
              "series": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["nameTemplate", "valuesTemplate"],
                  "properties": {
                    "nameTemplate": { "type": "string", "pattern": "\\{\\{[^{}]+\\}\\}" },
                    "valuesTemplate": { "type": "string", "pattern": "^\\{\\{[^{}]+\\}\\}$" }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": ["slideIndex", "role", "message", "importance", "density", "layoutSource", "visualPriority", "components", "renderRoutes", "editableLevel", "metrics"]
}
