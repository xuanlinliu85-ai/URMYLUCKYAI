{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Factory Deck Update Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["updateId", "sourceVersionId", "targets"],
  "properties": {
    "schema": { "const": "ppt-factory/deck-update-plan/v1" },
    "updateId": { "type": "string", "minLength": 1 },
    "sourceVersionId": { "type": "string", "minLength": 1 },
    "lockedDimensions": { "type": "array", "uniqueItems": true, "items": { "enum": ["typography", "color", "layout", "chart", "density", "composition", "storytelling", "visualTone"] } },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["targetId", "slideIndex", "kind", "value"],
            "properties": {
              "targetId": { "type": "string", "minLength": 1 },
              "slideIndex": { "type": "integer", "minimum": 1 },
              "kind": { "const": "text" },
              "stableId": { "type": "string", "minLength": 1 },
              "objectName": { "type": "string", "minLength": 1 },
              "value": { "type": "string" }
            },
            "anyOf": [{ "required": ["stableId"] }, { "required": ["objectName"] }]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["targetId", "slideIndex", "kind", "chart"],
            "properties": {
              "targetId": { "type": "string", "minLength": 1 },
              "slideIndex": { "type": "integer", "minimum": 1 },
              "kind": { "const": "chart" },
              "stableId": { "type": "string", "minLength": 1 },
              "objectName": { "type": "string", "minLength": 1 },
              "chart": {
                "type": "object",
                "additionalProperties": false,
                "required": ["categories", "series"],
                "properties": {
                  "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "series": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name", "values"],
                      "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "values": { "type": "array", "minItems": 1, "items": { "type": "number" } }
                      }
                    }
                  }
                }
              }
            },
            "anyOf": [{ "required": ["stableId"] }, { "required": ["objectName"] }]
          }
        ]
      }
    }
  }
}
