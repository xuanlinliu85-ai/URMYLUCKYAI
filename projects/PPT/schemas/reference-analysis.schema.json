{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Factory Reference Analysis",
  "type": "object",
  "properties": {
    "filename": { "type": "string" },
    "slideCount": { "type": "integer", "minimum": 0 },
    "slideSize": { "type": "object" },
    "fonts": { "type": "array" },
    "colors": { "type": "array" },
    "positions": { "type": "array" },
    "layouts": { "type": "array" },
    "masters": { "type": "array" },
    "charts": { "type": "integer", "minimum": 0 },
    "images": { "type": "integer", "minimum": 0 },
    "textCharacters": { "type": "integer", "minimum": 0 },
    "styleMeasurements": { "$ref": "reference-style-measurements.schema.json" },
    "slideRoles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "role": { "enum": ["cover", "agenda_section", "summary", "evidence_data", "comparison", "process_timeline", "closing", "other"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "signals": { "type": "object" }
        },
        "required": ["slide", "role", "confidence", "evidence", "signals"]
      }
    },
    "layoutFamilies": {
      "type": "array",
      "items": { "$ref": "#/$defs/layoutFamilyInference" }
    },
    "layoutFamilySummaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/layoutFamilySummary" }
    }
  },
  "required": ["filename", "slideCount", "slideSize", "fonts", "colors", "positions", "layouts", "masters", "charts", "images", "textCharacters", "slideRoles"],
  "$defs": {
    "layoutFamilyInference": {
      "type": "object",
      "properties": {
        "slide": { "type": "integer", "minimum": 1 },
        "family": { "$ref": "#/$defs/layoutFamily" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "signals": { "type": "object" }
      },
      "required": ["slide", "family", "confidence", "evidence", "signals"]
    },
    "layoutFamilySummary": {
      "type": "object",
      "properties": {
        "family": { "$ref": "#/$defs/layoutFamily" },
        "count": { "type": "integer", "minimum": 1 },
        "share": { "type": "number", "minimum": 0, "maximum": 1 },
        "averageConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "slides": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      },
      "required": ["family", "count", "share", "averageConfidence", "slides"]
    },
    "layoutFamily": {
      "enum": ["COVER", "SECTION", "EXEC_SUMMARY", "DATA_LEFT_TEXT_RIGHT", "TEXT_LEFT_DATA_RIGHT", "FULL_CHART", "FULL_TABLE", "BIG_NUMBER", "TWO_COLUMN", "HERO_IMAGE", "COMPARISON", "PROCESS_TIMELINE", "OTHER"]
    }
  }
}
