{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "PPT Factory Approval Decision", "type": "object", "additionalProperties": false,
  "required": ["schema", "requestId", "binding", "decision", "decidedBy", "decidedAt", "requestHash", "eventHash", "decisionHash"],
  "properties": {
    "schema": { "const": "ppt-factory/approval-decision/v1" }, "requestId": { "type": "string" }, "binding": { "$ref": "approval-request.schema.json#/$defs/binding" },
    "decision": { "enum": ["APPROVED", "REJECTED"] }, "decidedBy": { "type": "string" }, "decidedAt": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }, "requestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "eventHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "decisionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [{ "if": { "properties": { "decision": { "const": "REJECTED" } } }, "then": { "required": ["reason"] } }]
}
